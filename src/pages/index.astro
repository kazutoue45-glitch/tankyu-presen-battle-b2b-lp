.header-inner {
  display: flex; align-items: center; justify-content: space-between;
  padding: .55rem 0;
}
.header-logo { display: flex; align-items: center; flex-shrink: 0; gap: .5rem; text-decoration: none; }
.header-title {
  font-family: var(--f-heading); font-size: .9rem; font-weight: 900;
  color: var(--c-text); letter-spacing: .02em;
}
.header-logo-img { height: 30px; width: auto; }
.header-nav { display: flex; align-items: center; gap: 1.2rem; }
.header-nav a {
  font-family: var(--f-heading); font-size: .78rem; font-weight: 700;
  color: var(--c-text-mid); text-decoration: none;
  transition: color .2s; white-space: nowrap;
}
.header-nav a:hover { color: var(--c-blue); }
.header-cta-btn {
  display: inline-flex; align-items: center;
  font-family: var(--f-heading); font-size: .82rem; font-weight: 900;
  color: #fff; background: var(--c-blue);
  padding: .5rem 1.2rem; border-radius: 6px; text-decoration: none;
  white-space: nowrap; letter-spacing: .03em;
  box-shadow: 0 2px 8px rgba(37,99,235,.2);
  transition: transform .2s, box-shadow .2s, background .2s;
}
.header-cta-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(37,99,235,.3);
  background: var(--c-blue-dark); color: #fff;
}
.header-burger {
  display: none; background: none; border: none; cursor: pointer;
  width: 28px; height: 20px; position: relative; padding: 0;
}
.header-burger span {
  display: block; position: absolute; left: 0; width: 100%; height: 2.5px;
  background: var(--c-text); border-radius: 2px; transition: transform .3s, opacity .3s;
}
.header-burger span:nth-child(1) { top: 0; }
.header-burger span:nth-child(2) { top: 50%; transform: translateY(-50%); }
.header-burger span:nth-child(3) { bottom: 0; }
.header-burger.open span:nth-child(1) { top: 50%; transform: translateY(-50%) rotate(45deg); }
.header-burger.open span:nth-child(2) { opacity: 0; }
.header-burger.open span:nth-child(3) { bottom: auto; top: 50%; transform: translateY(-50%) rotate(-45deg); }

@media (max-width: 768px) {
  .header-nav {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(255,255,255,.97); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    flex-direction: column; justify-content: center; align-items: center; gap: 2rem;
    opacity: 0; pointer-events: none; transition: opacity .3s; z-index: 99;
  }
  .header-nav.open { opacity: 1; pointer-events: auto; }
  .header-nav a { font-size: 1.1rem; }
  .header-cta-btn { display: none; }
  .header-burger { display: block; z-index: 101; }
}


/* ─────────── S1 HERO ─────────── */
.hero {
  position: relative;
  min-height: 100dvh;
  display: flex; flex-direction: column; justify-content: center;
  text-align: center; overflow: hidden;
  padding-top: 3.5rem; color: #fff;
}
@media (max-width: 768px) {
  .hero { justify-content: flex-start; padding-top: 4.5rem; }
  .hero-inner { padding-top: .5rem; }
  .hero-bg-img { object-position: center 40%; }
  .hero-logo { max-width: 280px; }
}
.hero-bg {
  position: absolute; inset: 0; z-index: 0;
}
.hero-bg-img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center 55%;
}
.hero-overlay {
  position: absolute; inset: 0; z-index: 1;
  background: rgba(10, 18, 42, .35);
}
.hero-inner {
  position: relative; z-index: 2;
  padding: 1rem 1.5rem;
  max-width: 720px; margin: 0 auto;
}
.hero-logo {
  display: block; width: 100%; max-width: 720px;
  margin: 0 auto .8rem;
  filter: drop-shadow(0 4px 20px rgba(0,0,0,.4));
}
.hero-subtitle {
  font-family: var(--f-heading);
  font-size: clamp(1rem, 2.5vw, 1.3rem);
  font-weight: 700; color: rgba(255,255,255,.9);
  margin-bottom: 1rem; letter-spacing: .08em;
  text-shadow: 0 1px 4px rgba(0,0,0,.3);
}
.hero-catch {
  font-family: var(--f-heading);
  font-size: clamp(1.1rem, 2.8vw, 1.5rem);
  font-weight: 900; line-height: 1.65;
  color: #fff; margin-bottom: 1.5rem;
  text-shadow: 0 2px 8px rgba(0,0,0,.4);
}
.hero-tags {
  display: flex; flex-wrap: wrap; gap: .5rem;
  justify-content: center;
}
.hero-tag {
  font-size: .78rem; font-weight: 700;
  padding: .3rem .9rem; border-radius: 100px;
  border: 1px solid rgba(255,255,255,.35);
  background: rgba(255,255,255,.15); color: #fff;
  backdrop-filter: blur(4px);
}
.hero-tag--free {
  background: rgba(37,99,235,.85);
  border-color: rgba(37,99,235,.6);
  font-size: .85rem; font-weight: 900;
  padding: .35rem 1.1rem;
  letter-spacing: .06em;
}

/* CTA独立セクション */
.cta-sec { padding: clamp(1.5rem, 4vw, 2.5rem) 0; }
.cta-sec .cta-btn--lg {
  box-shadow: 0 6px 20px rgba(37,99,235,.3);
}


/* ─────────── CTA Dual ─────────── */
.cta-dual { text-align: center; }
.cta-sub {
  font-family: var(--f-heading);
  font-size: clamp(.9rem, 2vw, 1.05rem);
  font-weight: 700; color: var(--c-text-mid);
  margin-bottom: .6rem;
}


/* ─────────── S2 教育的意義 ─────────── */
.sig-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}
.sig-card {
  background: #fff;
  border: 1px solid var(--c-border);
  border-radius: var(--radius-md);
  padding: 1.8rem 1.5rem;
  display: flex; flex-direction: column;
  transition: box-shadow .2s;
}
.sig-card:hover { box-shadow: var(--shadow-md); }
.sig-card--accent {
  border-color: var(--c-blue);
  background: color-mix(in srgb, var(--c-blue) 4%, #fff);
}
.sig-step {
  display: inline-flex; align-items: center; justify-content: center;
  width: 32px; height: 32px; border-radius: 50%;
  background: var(--c-blue); color: #fff;
  font-family: var(--f-heading); font-size: .8rem; font-weight: 900;
  margin-bottom: .5rem;
}
.sig-card h3 {
  font-family: var(--f-heading);
  font-size: 1rem; font-weight: 900;
  margin-bottom: .4rem; line-height: 1.55;
  color: var(--c-text);
}
.sig-card p {
  font-size: .86rem; color: var(--c-text-light); line-height: 1.8;
  flex: 1;
}

@media (max-width: 768px) {
  .sig-grid { grid-template-columns: 1fr; }
}


/* ─────────── S3 団体参加メリット ─────────── */
.merit-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}
.merit-card {
  background: #fff; border-radius: var(--radius-md);
  padding: 2rem 1.5rem;
  border: 1px solid var(--c-border);
  transition: transform .2s ease, box-shadow .2s ease;
  display: flex; flex-direction: column;
}
.merit-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-md);
}
.merit-num {
  width: 44px; height: 44px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: .85rem; font-weight: 900; margin-bottom: .8rem;
  font-family: var(--f-heading);
  background: rgba(37,99,235,.08); color: var(--c-blue);
}
.merit-card h3 {
  font-family: var(--f-heading);
  font-size: 1rem; font-weight: 900;
  margin-bottom: .5rem; line-height: 1.55;
}
.merit-card p {
  font-size: .86rem; color: var(--c-text-light); line-height: 1.8;
  flex: 1;
}


/* ─────────── S4 大会テーマ ─────────── */
.theme-title {
  font-family: var(--f-heading);
  font-size: clamp(1.15rem, 3vw, 1.5rem);
  font-weight: 900; line-height: 1.6;
  text-align: left; margin-bottom: 1.5rem;
}

.theme-angles {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem; margin-bottom: 1.5rem;
}
.theme-angle-card {
  background: #fff; border-radius: var(--radius-md);
  padding: 1.5rem; border: 1px solid var(--c-border);
  text-align: left;
  transition: box-shadow .2s;
}
.theme-angle-card:hover { box-shadow: var(--shadow-sm); }
.theme-angle-card h4 {
  font-family: var(--f-heading);
  font-size: .9rem; font-weight: 900;
  margin-bottom: .4rem; color: var(--c-blue);
}
.theme-angle-card p {
  font-size: .85rem; color: var(--c-text-light); line-height: 1.8;
}

@media (max-width: 768px) {
  .theme-angles { grid-template-columns: 1fr; }
}

.theme-highlight {
  text-align: left; padding: 1rem 1.2rem;
  background: color-mix(in srgb, var(--c-blue) 5%, #fff);
  border: 1px solid color-mix(in srgb, var(--c-blue) 20%, #fff);
  border-radius: var(--radius-sm);
}
.theme-highlight p {
  font-size: .85rem; color: var(--c-text-mid);
  line-height: 1.75; font-weight: 600;
}

/* S5 大会概要テーブル */
.info-table {
  overflow: hidden;
  background: #fff;
  border: 1px solid var(--c-border);
  border-radius: var(--radius-md);
}
.info-table table { width: 100%; border-collapse: collapse; }
.info-table th,
.info-table td {
  padding: .9rem 1.2rem; font-size: .9rem;
  text-align: left; border-bottom: 1px solid var(--c-border-light);
}
.info-table tr:last-child th,
.info-table tr:last-child td { border-bottom: none; }
.info-table th {
  width: 160px; font-weight: 700;
  color: var(--c-text-mid); background: var(--c-bg-alt);
}
.info-free {
  color: var(--c-blue); font-size: 1.1rem;
  font-weight: 900; letter-spacing: .04em;
}


/* ─────────── S6 NORDT ─────────── */
.sec-heading .nordt-letters { font-size: clamp(1.3rem, 3vw, 1.7rem); letter-spacing: .06em; }
.sec-heading .nordt-letters b { font-weight: 900; }

.nordt-lead { text-align: left; margin-bottom: 1.8rem; }
.nordt-main-copy {
  font-family: var(--f-heading);
  font-size: clamp(1rem, 2.5vw, 1.2rem);
  font-weight: 900; line-height: 1.65; margin-bottom: .6rem;
  color: var(--c-text);
}
.nordt-sub-copy {
  font-size: .88rem; color: var(--c-text-light); line-height: 1.85;
}

.nordt-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: .8rem; margin-bottom: 1.5rem;
}
.nordt-card {
  display: flex; flex-direction: column; align-items: center;
  text-align: center; gap: .4rem;
  background: #fff; border: 1px solid var(--c-border);
  border-radius: var(--radius-md); padding: 1.2rem .6rem;
  min-height: 180px;
  transition: box-shadow .2s ease;
}
.nordt-card:hover { box-shadow: var(--shadow-sm); }
.nordt-l {
  width: 44px; height: 44px;
  border-radius: 50%; background: var(--nc); color: #fff;
  font-family: var(--f-heading); font-size: 1.2rem; font-weight: 900;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: .2rem;
}
.nordt-card strong { font-size: .95rem; display: block; }
.nordt-card small { font-size: .75rem; color: var(--c-text-muted); display: block; margin-bottom: .3rem; }
.nordt-card p { font-size: .82rem; color: var(--c-text-light); line-height: 1.6; }

@media (max-width: 768px) {
  .nordt-grid { grid-template-columns: repeat(2, 1fr); }
}


.nordt-note {
  font-size: .85rem; color: var(--c-text-light);
  text-align: left; line-height: 1.8;
  margin-bottom: 2.5rem;
}

/* NORDT × 探究学習マッピング */
.nordt-mapping {
  background: var(--c-bg-alt);
  border: 1px solid var(--c-border);
  border-radius: var(--radius-md);
  padding: 1.5rem;
}
.nordt-mapping-title {
  font-family: var(--f-heading);
  font-size: 1rem; font-weight: 900;
  text-align: left; margin-bottom: 1.2rem;
}
.nordt-mapping-grid {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: .8rem;
}
.nordt-map-item {
  display: flex; align-items: center; gap: .8rem;
  background: #fff; padding: .8rem 1rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--c-border);
}
.nordt-map-step {
  font-size: .85rem; font-weight: 700;
  color: var(--c-text-mid); flex: 1;
}
.nordt-map-arrow { color: var(--c-text-muted); font-size: .85rem; }
.nordt-map-axis {
  font-family: var(--f-heading);
  font-size: 1rem; font-weight: 900;
  min-width: 40px; text-align: center;
}
.nordt-map-axis b { margin: 0 .1em; }
.nordt-map-note {
  font-size: .8rem; color: var(--c-text-light);
  text-align: left; margin-top: .8rem;
  font-weight: 600;
}
.nordt-map-note b { font-weight: 900; }

@media (max-width: 768px) {
  .nordt-mapping-grid { grid-template-columns: 1fr; }
}


/* ─────────── S7 スケジュール ─────────── */
.sched-table-wrap {
  overflow-x: auto; -webkit-overflow-scrolling: touch;
}
.sched-table {
  width: 100%; border-collapse: collapse;
  font-size: .85rem; line-height: 1.6;
}
.sched-table thead th {
  font-family: var(--f-heading);
  font-size: .75rem; font-weight: 700;
  letter-spacing: .06em; color: #fff;
  background: var(--c-text); padding: .7rem .8rem;
  text-align: left; white-space: nowrap;
}
.sched-table tbody td {
  padding: .65rem .8rem;
  border-bottom: 1px solid var(--c-border);
  vertical-align: middle;
}
.sched-table tbody tr:last-child td { border-bottom: none; }
.sched-phase {
  font-weight: 700;
  background: color-mix(in srgb, var(--pc) 8%, #fff);
  border-left: 4px solid var(--pc);
  white-space: nowrap;
}
.sched-phase-label {
  font-family: var(--f-heading);
  font-size: .82rem; color: var(--c-text);
}
.sched-date {
  font-family: var(--f-heading);
  font-size: .8rem; font-weight: 700; white-space: nowrap;
}
.sched-final-row td {
  background: color-mix(in srgb, var(--nordt-t) 6%, #fff);
  font-weight: 700;
}
.sched-note {
  font-size: .82rem; color: var(--c-text-muted);
  text-align: left; margin-top: 1.2rem; line-height: 1.7;
}

@media (max-width: 600px) {
  .sched-table { font-size: .75rem; }
  .sched-table thead th,
  .sched-table tbody td { padding: .5rem .5rem; }
}


/* ─────────── S7.5 デザイン10 ─────────── */
.d10-flow {
  display: flex; flex-wrap: nowrap;
  justify-content: center; gap: .5rem;
  max-width: 100%; margin: 0 auto 1.5rem;
  padding: 1.5rem 0;
  align-items: center;
}
.d10-card {
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: .3rem;
  flex: 0 0 auto;
  width: clamp(60px, 7.5vw, 88px);
  min-height: clamp(85px, 9vw, 105px);
  padding: .7rem .3rem;
  background: #fff; border: 2px solid var(--dc);
  border-radius: var(--radius-sm);
  position: relative;
  transition: transform .2s, box-shadow .2s;
}
.d10-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 4px 12px color-mix(in srgb, var(--dc) 20%, transparent);
}
.d10-card--down { transform: none; }
.d10-card--down:hover { transform: translateY(-4px); }
.d10-card--up { transform: none; }
.d10-card--up:hover { transform: translateY(-4px); }
.d10-card--peak { transform: none; }
.d10-card--peak:hover { transform: translateY(-4px); }

.d10-num {
  font-family: var(--f-heading);
  font-size: .7rem; font-weight: 900;
  color: #fff; background: var(--dc);
  width: 22px; height: 22px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.d10-name {
  font-size: clamp(.6rem, 1.5vw, .72rem);
  font-weight: 700; text-align: center;
  line-height: 1.3; color: var(--c-text);
}
.d10-axis {
  font-family: var(--f-heading);
  font-size: .8rem; font-weight: 900;
  color: var(--dc);
}
.d10-axis b { color: var(--dc); }

.d10-wave-note {
  text-align: left; font-size: .82rem;
  color: var(--c-text-light); margin-bottom: 2rem;
  font-style: italic;
}

.d10-merit {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}
.d10-merit-item {
  background: #fff;
  border: 1px solid var(--c-border);
  border-radius: var(--radius-md);
  padding: 1.5rem;
  display: flex; flex-direction: column;
  text-align: left;
  transition: box-shadow .2s;
}
.d10-merit-item:hover { box-shadow: var(--shadow-sm); }

@media (max-width: 768px) {
  .d10-merit { grid-template-columns: 1fr; }
}
.d10-merit-item h4 {
  font-family: var(--f-heading);
  font-size: .88rem; font-weight: 900;
  margin-bottom: .4rem;
}
.d10-merit-item p {
  font-size: .82rem; color: var(--c-text-light); line-height: 1.75;
  flex: 1;
}

@media (max-width: 768px) {
  .d10-flow {
    justify-content: flex-start;
    overflow-x: auto; -webkit-overflow-scrolling: touch;
    padding: 1.5rem 1rem;
    gap: .4rem;
  }
  .d10-card { width: 64px; min-height: 80px; padding: .6rem .3rem; }
  .d10-card--down { transform: translateY(5px); }
  .d10-card--up { transform: translateY(-2px); }
  .d10-card--peak { transform: translateY(-6px); }
}


/* ─────────── キャラクター帯 ─────────── */
.char-band {
  display: flex; justify-content: center;
  gap: clamp(.5rem, 2vw, 1.5rem);
  padding: 2rem 1rem; background: var(--c-bg-alt); overflow: hidden;
}
.char-band-img {
  height: clamp(60px, 10vw, 90px); width: auto;
  opacity: .55; filter: grayscale(15%);
  transition: opacity .3s ease;
}
.char-band-img:hover { opacity: .85; }


/* ─────────── S8 プレゼンタイプ診断 ─────────── */
.diag-intro { text-align: left; margin-bottom: 2rem; }

.diag-sheet { margin-bottom: 2.5rem; }
.diag-sheet-title {
  font-family: var(--f-heading); font-size: 1.1rem; font-weight: 900;
  text-align: left; margin-bottom: 1.2rem;
}
.diag-sheet-grid {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
}
.diag-sheet-item {
  text-align: left; background: #fff;
  border: 1px solid var(--c-border); border-radius: var(--radius-md);
  padding: 1.5rem;
  transition: box-shadow .2s;
}
.diag-sheet-item:hover { box-shadow: var(--shadow-sm); }
.diag-sheet-icon { font-size: 1.5rem; display: block; margin-bottom: .5rem; }
.diag-sheet-item strong {
  font-family: var(--f-heading); font-size: .9rem; display: block; margin-bottom: .4rem;
}
.diag-sheet-item p { font-size: .82rem; color: var(--c-text-light); line-height: 1.7; }
@media (max-width: 768px) { .diag-sheet-grid { grid-template-columns: repeat(2, 1fr); } }
.diag-lead {
  font-family: var(--f-heading);
  font-size: clamp(.95rem, 2.5vw, 1.1rem);
  font-weight: 700; color: var(--c-text-mid); margin-bottom: .5rem;
}
.diag-big {
  font-family: var(--f-heading);
  font-size: clamp(1.3rem, 3.5vw, 1.8rem);
  font-weight: 900; color: var(--c-blue); margin-bottom: 1rem;
}
.diag-desc {
  font-size: .88rem; color: var(--c-text-light); line-height: 1.85;
}
.diag-chars { text-align: center; margin-bottom: 2.5rem; }
.diag-chars-img {
  max-width: 100%; border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

/* タイプカード（6グループ × 3列2行） */
.type-grid-title {
  font-family: var(--f-heading);
  font-size: 1.1rem; font-weight: 900;
  margin-bottom: 1.2rem;
}
.type-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}
.type-group {
  background: #fff; border: 1px solid var(--c-border);
  border-radius: var(--radius-md); padding: 1.5rem;
  transition: box-shadow .2s ease;
}
.type-group:hover { box-shadow: var(--shadow-sm); }
.type-group-title {
  font-family: var(--f-heading);
  font-size: .95rem; font-weight: 900;
  margin-bottom: 1rem; color: var(--c-text);
}
.type-group-cards {
  display: flex; flex-direction: column; gap: .8rem;
}
.type-card {
  display: flex; align-items: center; gap: .8rem;
  padding: .8rem; border-radius: var(--radius-sm);
  background: var(--c-bg-alt);
}
.type-card-img {
  width: 56px; height: 56px; object-fit: contain; flex-shrink: 0;
  filter: drop-shadow(0 2px 6px rgba(0,0,0,.08));
}
.type-card-name {
  font-family: var(--f-heading);
  font-size: .85rem; font-weight: 900; margin-bottom: .15rem;
}
