    transparent 30deg,rgba(74,144,217,.05) 40deg,transparent 50deg,
    transparent 60deg,rgba(76,175,80,.05) 70deg,transparent 80deg,
    transparent 90deg,rgba(245,166,35,.06) 100deg,transparent 110deg,
    transparent 120deg,rgba(208,72,62,.05) 130deg,transparent 140deg,
    transparent 150deg,rgba(155,81,224,.05) 160deg,transparent 170deg,
    transparent 180deg,rgba(255,215,0,.06) 190deg,transparent 200deg,
    transparent 210deg,rgba(74,144,217,.05) 220deg,transparent 230deg,
    transparent 240deg,rgba(76,175,80,.05) 250deg,transparent 260deg,
    transparent 270deg,rgba(245,166,35,.06) 280deg,transparent 290deg,
    transparent 300deg,rgba(208,72,62,.05) 310deg,transparent 320deg,
    transparent 330deg,rgba(155,81,224,.05) 340deg,transparent 350deg
  );
  animation:raysSpin 60s linear infinite;
  opacity:.8;
}
@keyframes raysSpin{to{transform:translate(-50%,-50%) rotate(360deg)}}

/* 浮遊バブル（NORDT5色） */
.hero-bubble{
  position:absolute;border-radius:50%;
  animation:bubbleFloat 6s ease-in-out infinite;
  opacity:.35;filter:blur(1px);
}
.hero-bubble--1{width:80px;height:80px;top:12%;left:8%;background:var(--nordt-n);animation-duration:7s}
