---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="探究プレゼンバトル2026 — 団体参加のご案内">

  <!-- ═══════ S1: ファーストビュー ═══════ -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-logos rv">
        <img src={`${import.meta.env.BASE_URL}images/hero-logo-2026.png`} alt="探究プレゼンバトル2026" class="hero-logo" />
      </div>

      <div class="hero-cohost rv rv-d1">
        <img src={`${import.meta.env.BASE_URL}images/orca.png`} alt="小川探究" class="cohost-logo" />
        <span class="cohost-x">&times;</span>
        <img src={`${import.meta.env.BASE_URL}images/valed-logo.png`} alt="バレッドキッズ" class="cohost-logo cohost-logo--valed" />
      </div>

      <h1 class="hero-headline rv rv-d2">
        あなたのスクールの生徒に、<br>
        全国規模の<em>"本番"</em>を。
      </h1>

      <p class="hero-sub rv rv-d3">
        探究プレゼンバトル2026<br class="sp-only">団体参加のご案内
      </p>

      <div class="hero-tags rv rv-d4">
        <span class="htag">参加無料</span>
        <span class="htag">オンライン開催</span>
        <span class="htag">全員にフィードバック</span>
      </div>
    </div>
  </section>


  <!-- ═══════ S2: 課題提起 ═══════ -->
  <section class="sec sec--alt">
    <div class="container--narrow">
      <h2 class="sec-heading rv">
        スクール内の発表会だけでは、<br>
        <span class="accent">届かない成長</span>がある
        <span class="sec-heading-bar"></span>
      </h2>

      <div class="challenge-grid">
        <div class="challenge-item rv">
          <div class="challenge-num">01</div>
          <div class="challenge-body">
            <p class="challenge-text">いつも同じメンバー、同じ先生の前で発表する。それだけだと「慣れ」にはなるけど、「緊張感のある本番」にはならない。</p>
          </div>
        </div>

        <div class="challenge-item rv rv-d1">
          <div class="challenge-num">02</div>
          <div class="challenge-body">
            <p class="challenge-text">知らない大人の前で話す。初めての審査員からフィードバックをもらう。その経験が、生徒の目の色を変える。でもスクール単体では、その場をつくるのが難しい。</p>
          </div>
        </div>

        <div class="challenge-item rv rv-d2">
          <div class="challenge-num">03</div>
          <div class="challenge-body">
            <p class="challenge-text">保護者からすると「うちの子、通ってて何が身についたの？」が見えにくい。発表会の動画を送るだけでは、成長の実感が伝わりきらない。</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════ S3: 大会概要 ═══════ -->
  <section class="sec">
    <div class="container--narrow">
      <h2 class="sec-heading rv">
        探究プレゼンバトルとは
        <span class="sec-heading-bar"></span>
      </h2>

      <div class="overview-box rv">
        <p class="overview-lead">小学生から高校生まで、全国の子どもたちが「地域の未来」をテーマにプレゼンで競い合うオンライン大会です。</p>

        <div class="overview-detail">
          <dl class="overview-dl">
            <div class="overview-row">
              <dt>形式</dt>
              <dd>3分間のプレゼン動画を提出 → 審査 → 決勝はZoomライブ</dd>
            </div>
            <div class="overview-row">
              <dt>テーマ</dt>
              <dd>「あなたの街の10年後！ ―地域活性化を提案せよ―」</dd>
            </div>
            <div class="overview-row">
              <dt>対象</dt>
              <dd>小学生〜高校生（個人 or チーム参加）</dd>
            </div>
            <div class="overview-row">
              <dt>参加費</dt>
              <dd>無料</dd>
            </div>
            <div class="overview-row">
              <dt>開催形式</dt>
              <dd>完全オンライン（動画提出 + Zoom）</dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="features rv">
        <div class="feature-card rv rv-d1">
          <div class="feature-icon">🎯</div>
          <h3>全員にプロからのフィードバック</h3>
          <p>入賞に関係なく、参加者全員にNORDT基準の評価シートをお届けします。</p>
        </div>
        <div class="feature-card rv rv-d2">
          <div class="feature-icon">🏠</div>
          <h3>移動不要・完全オンライン</h3>
          <p>動画提出もZoom選考もすべてオンライン。地方からでも気軽に参加できます。</p>
        </div>
        <div class="feature-card rv rv-d3">
          <div class="feature-icon">📊</div>
          <h3>NORDT診断で成長が見える</h3>
          <p>5つの軸で生徒一人ひとりの強みと伸びしろを客観的に可視化します。</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════ S4: 団体参加のメリット ═══════ -->
  <section class="sec sec--section">
    <div class="container--narrow">
      <h2 class="sec-heading rv">
        団体参加で得られること
        <span class="sec-heading-bar"></span>
      </h2>

      <div class="merit-list">
        <div class="merit rv">
          <div class="merit-badge" style="background: var(--nordt-n);">1</div>
          <div class="merit-content">
            <h3>生徒に「外の本番」を提供できる</h3>
            <p>スクールの外で、知らない審査員の前でプレゼンする。この体験が「普段の授業では出ない本気」を引き出します。保護者にも「ここまでできるようになったんだ」という実感が伝わります。</p>
          </div>
        </div>

        <div class="merit rv rv-d1">
          <div class="merit-badge" style="background: var(--nordt-o);">2</div>
          <div class="merit-content">
            <h3>NORDT診断で、成長を"数字"で見せられる</h3>
            <p>「なんとなく上手になった」ではなく、Needs・Original・Real・Design・Talkの5軸でスコアが出る。保護者面談やスクールの成果報告に、そのまま使えます。</p>
          </div>
        </div>

        <div class="merit rv rv-d2">
          <div class="merit-badge" style="background: var(--nordt-r);">3</div>
          <div class="merit-content">
            <h3>「全国大会出場」が、保護者への強い訴求になる</h3>
            <p>「うちのスクールの生徒が全国大会に出ました」。このひと言は、新規入会の後押しになります。スクールの教育成果を目に見えるかたちで発信できます。</p>
          </div>
        </div>

        <div class="merit rv rv-d3">
          <div class="merit-badge" style="background: var(--nordt-d);">4</div>
          <div class="merit-content">
            <h3>全員にプロからのフィードバックが届く</h3>
            <p>結果がどうであれ、参加した生徒全員にフィードバックが届きます。「出てよかった」と感じてもらえる大会にすることを大切にしています。</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════ 中間CTA ═══════ -->
  <section class="sec">
    <div class="cta-wrap rv">
      <a href="#" class="cta-btn">無料でエントリーする →</a>
      <p class="cta-note">参加費無料・全員にフィードバックをお届けします</p>
    </div>
  </section>


  <!-- ═══════ S5: NORDT評価基準 ═══════ -->
  <section class="sec sec--deep">
    <div class="container--narrow">
      <h2 class="sec-heading rv" style="color:#fff;">
        NORDT ― 5つの評価軸
        <span class="sec-heading-bar" style="background: var(--c-orange);"></span>
      </h2>

      <p class="nordt-intro rv">
        この大会では、参加者全員を<strong>NORDT</strong>（ノルト）という独自の5軸で評価します。<br>
        順位をつけるためだけの基準ではなく、「この子はどこが強くて、どこを伸ばせるか」を見るためのものです。<br>
        スクールでの指導にもそのまま活用できます。
      </p>

      <div class="nordt-grid">
        <div class="nordt-item rv" style="--nc: var(--nordt-n);">
          <span class="nordt-letter">N</span>
          <div>
            <strong>Needs</strong>
            <small>課題把握力</small>
            <p>課題の本質を見抜き、ニーズを正しく捉えているか</p>
          </div>
        </div>

        <div class="nordt-item rv rv-d1" style="--nc: var(--nordt-o);">
          <span class="nordt-letter">O</span>
          <div>
            <strong>Original</strong>
            <small>独創性</small>
            <p>独創性があり、自分らしいこだわりが感じられるか</p>
          </div>
        </div>

        <div class="nordt-item rv rv-d2" style="--nc: var(--nordt-r);">
          <span class="nordt-letter">R</span>
          <div>
            <strong>Real</strong>
            <small>現実性</small>
            <p>多角的に考え、現実的なプランに落とし込めているか</p>
          </div>
        </div>

        <div class="nordt-item rv rv-d3" style="--nc: var(--nordt-d);">
          <span class="nordt-letter">D</span>
          <div>
            <strong>Design</strong>
            <small>構成力</small>
            <p>スライドが論理的かつ印象に残る構成になっているか</p>
          </div>
        </div>

        <div class="nordt-item rv rv-d4" style="--nc: var(--nordt-t);">
          <span class="nordt-letter">T</span>
          <div>
            <strong>Talk</strong>
            <small>話術</small>
            <p>聞き手を引き込む話し方ができているか</p>
          </div>
        </div>
      </div>

      <div class="nordt-note rv">
        <p>参加者全員に、この5軸をもとにした<strong>評価シート</strong>と<strong>プレゼンタイプ診断</strong>をお届けします。</p>
      </div>
    </div>
  </section>


  <!-- ═══════ S6: 大会スケジュール ═══════ -->
  <section class="sec sec--alt">
    <div class="container--narrow">
      <h2 class="sec-heading rv">
        大会スケジュール
        <span class="sec-heading-bar"></span>
      </h2>

      <div class="schedule-table rv">
        <table>
          <thead>
            <tr>
              <th>フェーズ</th>
              <th>期間</th>
              <th>内容</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><span class="phase-tag" style="background: var(--nordt-n);">エントリー</span></td>
              <td>〜 8/20</td>
              <td>フォームからエントリー + 3分のプレゼン動画を提出</td>
            </tr>
            <tr>
              <td><span class="phase-tag" style="background: var(--nordt-o);">一次選考</span></td>
              <td>8/21 〜 9/20</td>
              <td>動画をNORDT基準で審査。通過チームを発表</td>
            </tr>
            <tr>
              <td><span class="phase-tag" style="background: var(--nordt-r);">二次選考</span></td>
              <td>10/1 〜 10/20</td>
              <td>Zoomでライブプレゼン。上位10チームを選出</td>
            </tr>
            <tr>
              <td><span class="phase-tag" style="background: var(--nordt-d);">個別レクチャー</span></td>
              <td>10/21 〜 11/15</td>
              <td>プロによるマンツーマン指導で決勝に備える</td>
            </tr>
            <tr>
              <td><span class="phase-tag" style="background: var(--nordt-t);">決勝大会</span></td>
              <td>11/22（日）</td>
              <td>オンライン決勝。審査 + 表彰</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>


  <!-- ═══════ S7: 団体参加の流れ ═══════ -->
  <section class="sec">
    <div class="container--narrow">
      <h2 class="sec-heading rv">
        団体参加の流れ
        <span class="sec-heading-bar"></span>
      </h2>

      <ol class="flow-list">
        <li class="flow-step rv">
          <div class="flow-num" style="background: var(--nordt-n);">1</div>
          <div class="flow-body">
            <h3>お問い合わせ・エントリー</h3>
            <p>まずは下のボタンからお問い合わせください。団体参加の進め方をご案内します。</p>
          </div>
        </li>

        <li class="flow-step rv rv-d1">
          <div class="flow-num" style="background: var(--nordt-o);">2</div>
          <div class="flow-body">
            <h3>スクール内でテーマに取り組む</h3>
            <p>「あなたの街の10年後」をテーマに、授業やワークショップの中でプレゼン準備を進めてください。</p>
          </div>
        </li>

        <li class="flow-step rv rv-d2">
          <div class="flow-num" style="background: var(--nordt-r);">3</div>
          <div class="flow-body">
            <h3>生徒が動画を提出</h3>
            <p>3分間のプレゼン動画を撮影し、提出フォームからアップロード。スマホ撮影でOKです。</p>
          </div>
        </li>

        <li class="flow-step rv rv-d3">
          <div class="flow-num" style="background: var(--nordt-d);">4</div>
          <div class="flow-body">
            <h3>選考・フィードバック</h3>
            <p>NORDT基準で審査し、全員に評価シートをお届け。結果に関わらず、一人ひとりにコメントが届きます。</p>
          </div>
        </li>

        <li class="flow-step rv rv-d4">
          <div class="flow-num" style="background: var(--nordt-t);">5</div>
          <div class="flow-body">
            <h3>入賞チームは決勝へ</h3>
            <p>上位チームはオンライン決勝に進出。プロの個別レクチャーを受けて、最高のプレゼンに磨き上げます。</p>
          </div>
        </li>
      </ol>
    </div>
  </section>


  <!-- ═══════ S8: 主催者情報 ═══════ -->
  <section class="sec sec--alt">
    <div class="container--narrow">
      <h2 class="sec-heading rv">
        主催
        <span class="sec-heading-bar"></span>
      </h2>

      <div class="organizer-grid">
        <div class="organizer rv">
          <img src={`${import.meta.env.BASE_URL}images/orca.png`} alt="小川探究" class="organizer-logo" />
          <div class="organizer-info">
            <h3>小川探究</h3>
            <p>子どもたちの「なぜ？」を大切にした探究教育プログラムを展開。全国の教育機関と連携し、プレゼン力や思考力を育てる取り組みを行っています。</p>
            <a href="https://ogawa-tankyu.jp" target="_blank" rel="noopener">ogawa-tankyu.jp</a>
          </div>
        </div>

        <div class="organizer rv rv-d1">
          <img src={`${import.meta.env.BASE_URL}images/valed-logo.png`} alt="バレッドキッズ" class="organizer-logo organizer-logo--valed" />
          <div class="organizer-info">
            <h3>バレッドキッズ</h3>
            <p>ICTを活用した子ども向け教育を全国で展開。プログラミング、プレゼンテーション、タイピングなど、これからの時代に求められるスキルを育てています。</p>
            <a href="https://kids.valed.jp" target="_blank" rel="noopener">kids.valed.jp</a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════ S9: CTA ═══════ -->
  <section class="sec sec--cta">
    <div class="container--narrow">
      <div class="final-cta rv">
        <img src={`${import.meta.env.BASE_URL}images/characters.webp`} alt="" class="final-cta-characters" />
        <h2>生徒の「本気」が見える場を、<br>一緒につくりませんか？</h2>
        <div class="cta-wrap">
          <a href="#" class="cta-btn cta-btn--lg">無料でエントリーする →</a>
          <p class="cta-note">参加無料 ・ 全員にフィードバックをお届けします</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════ Footer ═══════ -->
  <footer class="footer">
    <div class="container">
      <img src={`${import.meta.env.BASE_URL}images/logo.png`} alt="探究プレゼンバトル" class="footer-logo" />
      <p class="footer-copy">&copy; 2026 探究プレゼンバトル実行委員会</p>
    </div>
  </footer>

</Layout>

<style>
/* ═══════════════════════════════════════════
   S1: ファーストビュー
   ═══════════════════════════════════════════ */
.hero {
  background:
    radial-gradient(ellipse 80% 60% at 50% 40%, rgba(74,144,217,0.06) 0%, transparent 70%),
    linear-gradient(180deg, #FAFBFD 0%, #FFFFFF 100%);
  padding: clamp(3rem, 8vw, 5rem) 0 clamp(2.5rem, 6vw, 4rem);
  text-align: center;
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--nordt-n), var(--nordt-o), var(--nordt-r), var(--nordt-d), var(--nordt-t));
}

.hero-inner {
  position: relative;
  z-index: 1;
}

.hero-logo {
  max-width: clamp(260px, 45vw, 420px);
  margin: 0 auto 1.5rem;
}

.hero-cohost {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .8rem;
  margin-bottom: 2rem;
}

.cohost-logo {
  height: clamp(28px, 4vw, 40px);
  width: auto;
}

.cohost-logo--valed {
  height: clamp(22px, 3.5vw, 34px);
}

.cohost-x {
  font-size: 1.2rem;
  color: var(--c-text-muted);
  font-weight: 300;
}

.hero-headline {
  font-family: var(--f-heading);
  font-size: clamp(1.4rem, 4.5vw, 2.4rem);
  font-weight: 900;
  line-height: 1.5;
  color: var(--c-text);
  margin-bottom: 1rem;
}

.hero-headline em {
  font-style: normal;
  color: var(--c-accent);
  position: relative;
}

.hero-headline em::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--c-accent);
  border-radius: 2px;
  opacity: .4;
}

.hero-sub {
  font-size: clamp(.95rem, 2vw, 1.15rem);
  color: var(--c-text-mid);
  margin-bottom: 1.5rem;
  line-height: 1.6;
  font-weight: 700;
}

.hero-tags {
  display: flex;
  gap: .6rem;
  justify-content: center;
  flex-wrap: wrap;
}

.htag {
  display: inline-block;
  padding: .4rem 1rem;
  border: 2px solid var(--c-accent);
  border-radius: 100px;
  font-size: .82rem;
  font-weight: 700;
  color: var(--c-accent);
  background: rgba(74, 144, 217, 0.06);
}

.sp-only { display: none; }
@media (max-width: 600px) {
  .sp-only { display: inline; }
}


/* ═══════════════════════════════════════════
   S2: 課題提起
   ═══════════════════════════════════════════ */
.challenge-grid {
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
}

.challenge-item {
  display: flex;
  gap: 1.2rem;
  align-items: flex-start;
  background: var(--c-white);
  padding: 1.5rem 1.8rem;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  transition: box-shadow .3s;
}

.challenge-item:hover {
  box-shadow: var(--shadow-md);
}

.challenge-num {
  font-family: var(--f-heading);
  font-size: 1.6rem;
  font-weight: 900;
  color: var(--c-accent);
  opacity: .35;
  flex-shrink: 0;
  line-height: 1.4;
}

.challenge-text {
  font-size: .95rem;
  color: var(--c-text-mid);
  line-height: 1.8;
}


/* ═══════════════════════════════════════════
   S3: 大会概要
   ═══════════════════════════════════════════ */
.overview-box {
  background: var(--c-bg-alt);
  border-radius: var(--radius-md);
  padding: 2rem 2.2rem;
  margin-bottom: 2.5rem;
}

.overview-lead {
  font-size: clamp(.95rem, 1.8vw, 1.1rem);
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 1.5rem;
  line-height: 1.75;
}

.overview-dl {
  display: flex;
  flex-direction: column;
  gap: .6rem;
}

.overview-row {
  display: flex;
  gap: 1rem;
  align-items: baseline;
  padding: .5rem 0;
  border-bottom: 1px solid var(--c-border-light);
}

.overview-row:last-child {
  border-bottom: none;
}

.overview-row dt {
  font-weight: 700;
  font-size: .88rem;
  color: var(--c-accent);
  min-width: 80px;
  flex-shrink: 0;
}

.overview-row dd {
  font-size: .92rem;
  color: var(--c-text-mid);
  line-height: 1.7;
}

.features {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
